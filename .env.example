# Copie para .env e preencha com os valores do projeto Supabase
# (Supabase Studio -> Settings -> API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=chave-anon-publica-aqui

# Webhook do n8n que roda a fila de disparo (workflow "DISPARO PROSPECÇÃO
# (painel + supabase)"). O painel só avisa "comecei" — nenhum dado de contato
# passa por aqui, o n8n lê tudo do Supabase.
VITE_N8N_DISPARO_URL=https://SEU-N8N/webhook/disparo-prospeccao
